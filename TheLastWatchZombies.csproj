<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <Version>2.0.10</Version><AssemblyName>TheLastWatchZombies</AssemblyName><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <Reference Include="VintagestoryAPI"><HintPath>$(VintageStoryPath)/VintagestoryAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VSEssentials"><HintPath>$(VintageStoryPath)/Mods/VSEssentials.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VSSurvivalMod"><HintPath>$(VintageStoryPath)/Mods/VSSurvivalMod.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(VintageStoryPath)/Lib/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(VintageStoryPath)/Lib/Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckGamePath" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(VintageStoryPath)/VintagestoryAPI.dll')" Text="Set -p:VintageStoryPath to your Vintage Story 1.22.7 installation folder." />
  </Target>
  <Target Name="PackageMod" AfterTargets="Build">
    <PropertyGroup><Stage>$(MSBuildProjectDirectory)/dist/staging</Stage></PropertyGroup>
    <RemoveDir Directories="$(Stage)" /><MakeDir Directories="$(Stage)" />
    <ItemGroup><Assets Include="$(MSBuildProjectDirectory)/assets/**/*" /></ItemGroup>
    <Copy SourceFiles="@(Assets)" DestinationFiles="@(Assets->'$(Stage)/assets/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="$(TargetPath);$(MSBuildProjectDirectory)/modinfo.json;$(MSBuildProjectDirectory)/modicon.png;$(MSBuildProjectDirectory)/LICENSE;$(MSBuildProjectDirectory)/README.md" DestinationFolder="$(Stage)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/UPDATE-NOTES.md;$(MSBuildProjectDirectory)/RELEASE-REVIEW.md;$(MSBuildProjectDirectory)/RELEASE-PLAYTEST.md;$(MSBuildProjectDirectory)/CONFIG-REFERENCE.md" DestinationFolder="$(Stage)" />
    <ZipDirectory SourceDirectory="$(Stage)" DestinationFile="$(MSBuildProjectDirectory)/dist/thelastwatchzombies_$(Version).zip" Overwrite="true" />
  </Target>
</Project>
